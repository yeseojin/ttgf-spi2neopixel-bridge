trokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960" y="570" as="sourcePoint"/><mxPoint x="380" y="340" as="targetPoint"/><Array as="points"><mxPoint x="960" y="648"/><mxPoint x="380" y="648"/></Array></mxGeometry></mxCell><mxCell id="c84" value="status[7:0] = {ready, flags[4:0], state[1:0]}" style="text;html=1;align=left;verticalAlign=middle;fontSize=6;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="390" y="638" width="230" height="10" as="geometry"/></mxCell><mxCell id="c85" style="edgeStyle=none;html=1;endArrow=block;endSize=4;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1070" y="240" as="sourcePoint"/><mxPoint x="1130" y="240" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c86" value="uo_out[7:0]" style="text;html=1;align=left;verticalAlign=middle;fontSize=6;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1072" y="226" width="70" height="10" as="geometry"/></mxCell><mxCell id="c87" value="NeoPixel ch0-7" style="text;html=1;align=left;verticalAlign=middle;fontSize=6;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1072" y="244" width="70" height="10" as="geometry"/></mxCell><mxCell id="c88" style="edgeStyle=none;html=1;endArrow=block;endSize=4;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1070" y="500" as="sourcePoint"/><mxPoint x="1130" y="500" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c89" value="uio[7] READY" style="text;html=1;align=left;verticalAlign=middle;fontSize=6;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1084" y="490" width="60" height="10" as="geometry"/></mxCell><mxCell id="c90" style="edgeStyle=none;html=1;endArrow=block;endSize=4;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="340" as="sourcePoint"/><mxPoint x="1130" y="660" as="targetPoint"/><Array as="points"><mxPoint x="440" y="660"/></Array></mxGeometry></mxCell><mxCell id="c91" value="MISO, oe only during 05h" style="text;html=1;align=left;verticalAlign=middle;fontSize=6;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="900" y="662" width="150" height="10" as="geometry"/></mxCell><mxCell id="c92" value="uio[0] MISO" style="text;html=1;align=left;verticalAlign=middle;fontSize=6;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1084" y="650" width="60" height="10" as="geometry"/></mxCell><mxCell id="c93" value="&lt;b&gt;Notes&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=7;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="24" y="684" width="1120" height="14" as="geometry"/></mxCell><mxCell id="c94" value="1. DFF 235 [calculated, Yosys / LibreLane]. Utilization 75.1 %, 1x1 tile. Setup +10.51 ns at tt_025C_3v30, 40 MHz, timing criterion = 25 C [calculated, hardening]." style="text;html=1;align=left;verticalAlign=middle;fontSize=7;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="24" y="700" width="1120" height="14" as="geometry"/></mxCell><mxCell id="c95" value="2. Timing in clk [calculated]: T0H/T1H/TBIT 40 MHz 12/36/50, 32 MHz 10/28/40, 20 MHz 6/18/25 (SEL 11 = 20 MHz). TRESET 300 us. Bit period 1.25 us." style="text;html=1;align=left;verticalAlign=middle;fontSize=7;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="24" y="716" width="1120" height="14" as="geometry"/></mxCell><mxCell id="c96" value="3. CONFIG 01h + 1 byte (IDLE only): [2:0] CH, [4:3] SEL, [5] SNOOP. Reset: 1 channel, 40 MHz, snoop off. STATUS 05h: SCK &lt;= clk/8 [engineer]." style="text;html=1;align=left;verticalAlign=middle;fontSize=7;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="24" y="732" width="1120" height="14" as="geometry"/></mxCell><mxCell id="c97" value="4. READY = IDLE/STREAM, hold_buf empty, no burst in progress. Error flags clear at next frame start. No ERROR pin; read with 05h [engineer]." style="text;html=1;align=left;verticalAlign=middle;fontSize=7;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="24" y="748" width="1120" height="14" as="geometry"/></mxCell><mxCell id="c98" value="5. Snoop: DWIN high = one burst of N bytes, no command byte. New PSRAM read per burst (CE# low &lt;= tCEM). MCU bus CS_n high while DWIN high." style="text;html=1;align=left;verticalAlign=middle;fontSize=7;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="24" y="764" width="1120" height="14" as="geometry"/></mxCell><mxCell id="c99" value="6. uio_oe: uio[7] always output, uio[0] output only during 05h. QSPI Pmod needs J2 rows F and B cut." style="text;html=1;align=left;verticalAlign=middle;fontSize=7;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="24" y="780" width="1120" height="14" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>