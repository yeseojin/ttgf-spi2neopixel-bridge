"1025" y="624"/><mxPoint x="620" y="624"/></Array></mxGeometry></mxCell><mxCell id="c68" value="state" style="text;html=1;align=left;verticalAlign=middle;fontSize=6;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="630" y="614" width="150" height="10" as="geometry"/></mxCell><mxCell id="c69" style="edgeStyle=none;html=1;endArrow=block;endSize=4;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1000" y="340" as="sourcePoint"/><mxPoint x="1000" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c70" value="underrun&lt;br&gt;drained&lt;br&gt;hold_full" style="text;html=1;align=left;verticalAlign=middle;fontSize=6;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1004" y="420" width="44" height="30" as="geometry"/></mxCell><mxCell id="c71" style="edgeStyle=none;html=1;endArrow=block;endSize=4;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="470" as="sourcePoint"/><mxPoint x="1060" y="340" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c72" value="tx_en" style="text;html=1;align=left;verticalAlign=middle;fontSize=6;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1064" y="380" width="40" height="10" as="geometry"/></mxCell><mxCell id="c73" style="edgeStyle=none;html=1;endArrow=block;endSize=4;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1070" y="240" as="sourcePoint"/><mxPoint x="1130" y="240" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c74" value="uo_out[7:0]" style="text;html=1;align=left;verticalAlign=middle;fontSize=6;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1072" y="226" width="70" height="10" as="geometry"/></mxCell><mxCell id="c75" value="NeoPixel ch0-7" style="text;html=1;align=left;verticalAlign=middle;fontSize=6;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1072" y="244" width="70" height="10" as="geometry"/></mxCell><mxCell id="c76" style="edgeStyle=none;html=1;endArrow=block;endSize=4;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1070" y="500" as="sourcePoint"/><mxPoint x="1130" y="500" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c77" value="uio[2] READY" style="text;html=1;align=left;verticalAlign=middle;fontSize=6;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1084" y="490" width="60" height="10" as="geometry"/></mxCell><mxCell id="c78" style="edgeStyle=none;html=1;endArrow=block;endSize=4;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1070" y="524" as="sourcePoint"/><mxPoint x="1130" y="524" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c79" value="uio[3] ERROR" style="text;html=1;align=left;verticalAlign=middle;fontSize=6;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1084" y="514" width="60" height="10" as="geometry"/></mxCell><mxCell id="c80" value="&lt;b&gt;Notes&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=7;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="24" y="684" width="1120" height="14" as="geometry"/></mxCell><mxCell id="c81" value="1. DFF estimates [derived]: sync_in ~18, spi_rx ~14, burst_ctrl ~10, hold_buf 65, px_tx ~75, frame_ctrl ~18, total ~200. Tile fit decided by synthesis." style="text;html=1;align=left;verticalAlign=middle;fontSize=7;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="24" y="700" width="1120" height="14" as="geometry"/></mxCell><mxCell id="c82" value="2. Timing in clk counts [calculated]: 32 MHz T0H/T1H/TBIT = 10/26/38, 16 MHz = 5/13/19, TRESET 300 us. Common window of WS2812 and WS2812B." style="text;html=1;align=left;verticalAlign=middle;fontSize=7;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="24" y="716" width="1120" height="14" as="geometry"/></mxCell><mxCell id="c83" value="3. Commands [engineer]: 02h WRITE (1-bit), 32h WRITE_QUAD (data 4-bit), A5h LATCH. One command per burst, burst = N bytes, N = CH + 1." style="text;html=1;align=left;verticalAlign=middle;fontSize=7;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="24" y="732" width="1120" height="14" as="geometry"/></mxCell><mxCell id="c84" value="4. READY = hold buffer empty. ERROR = discarded burst or underrun, cleared when FSM returns to IDLE [engineer]." style="text;html=1;align=left;verticalAlign=middle;fontSize=7;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="24" y="748" width="1120" height="14" as="geometry"/></mxCell><mxCell id="c85" value="5. SEL and CH are static config pins, not synchronized. uio[0] is IO1 input only; MISO reserved for optional read command (after synthesis)." style="text;html=1;align=left;verticalAlign=middle;fontSize=7;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="24" y="764" width="1120" height="14" as="geometry"/></mxCell><mxCell id="c86" value="6. uio_oe: uio[2], uio[3] output; others input. Unused outputs driven 0." style="text;html=1;align=left;verticalAlign=middle;fontSize=7;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="24" y="780" width="1120" height="14" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>